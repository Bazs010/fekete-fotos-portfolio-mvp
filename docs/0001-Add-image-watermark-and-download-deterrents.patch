diff --git a/docs/script.js b/docs/script.js
index 8361b82..4721623 100644
--- a/docs/script.js
+++ b/docs/script.js
@@ -16,6 +16,30 @@ const observer = new IntersectionObserver((entries) => {
 }, { threshold: 0.12 });
 document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
 
+// A böngészőben megjelenő képek teljes letöltésvédelme nem lehetséges,
+// de a vízjel, a húzás és a helyi menü tiltása visszatartja az egyszerű mentést.
+document.querySelectorAll('.hero, .work-card, .gallery-item').forEach((container) => {
+  const watermark = document.createElement('span');
+  watermark.className = 'image-watermark';
+  watermark.textContent = 'VEZETÉK KERESZT';
+  watermark.setAttribute('aria-hidden', 'true');
+  container.appendChild(watermark);
+});
+
+document.querySelectorAll('img').forEach((image) => {
+  image.draggable = false;
+});
+
+document.addEventListener('contextmenu', (event) => {
+  if (event.target.closest('.hero, .work-card, .gallery-item')) {
+    event.preventDefault();
+  }
+});
+
+document.addEventListener('dragstart', (event) => {
+  if (event.target.matches('img')) event.preventDefault();
+});
+
 document.querySelectorAll('.filter').forEach((button) => {
   button.addEventListener('click', () => {
     document.querySelectorAll('.filter').forEach((item) => item.classList.remove('active'));
